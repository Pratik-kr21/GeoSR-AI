# GeoSR-AI Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# The application will start without CDSE credentials — real-time
# Sentinel-2 fetching will simply be disabled until they are added.

# ─────────────────────────────────────────────────────────────────────────────
# CDSE (Copernicus Data Space Ecosystem) — FREE Sentinel-2 data
# ─────────────────────────────────────────────────────────────────────────────
#
# Step 1: Register a free account at https://dataspace.copernicus.eu/
#
# Step 2: Go to your account settings:
#   https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
#
# Step 3: Create a new OAuth Client:
#   - Click "OAuth Clients" in the left sidebar
#   - Click "Add Client"
#   - Enter any name (e.g. "GeoSR-AI")
#   - Copy the generated Client ID and Client Secret below
#
# Important: Sentinel-2 has a 5-day revisit cycle. The freshest possible
# clear-sky image is typically 5-10 days old — this is physically unavoidable.
#
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# Google Earth Engine — For multi-decadal historical analysis and composites
# ─────────────────────────────────────────────────────────────────────────────
# Set the path to your GEE Service Account JSON key file.
# E.g., /app/gee_key.json inside Docker, or a local path.
GEE_CREDENTIALS_PATH=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PROJECT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Open-Meteo — FREE weather API (no key required)
# ─────────────────────────────────────────────────────────────────────────────
# This is pre-configured. You do not need to change this.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
